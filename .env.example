# TypeScript -> local Python gateway
TWIN_LLM_URL=http://127.0.0.1:8099
TWIN_LLM_AUDIT_PATH=data/output/llm-audit.jsonl

# Option A: central LiteLLM proxy (preferred for shared policy/routing)
LITELLM_PROXY_URL=http://127.0.0.1:4000/v1
LITELLM_MASTER_KEY=change-me

# LiteLLM proxy -> OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_INTENT_MODEL=openrouter/auto
OPENROUTER_GUIDELINES_MODEL=openrouter/auto
OPENROUTER_CODE_MODEL=openrouter/auto
OPENROUTER_VALIDATION_MODEL=openrouter/auto

# Option B: private OpenAI-compatible endpoint (Ollama/vLLM/LM Studio/custom proxy)
LOCAL_LLM_API_BASE=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=local-not-required
# Example: LOCAL_LLM_API_BASE=http://127.0.0.1:11434/v1
# Example: LOCAL_LLM_MODEL=your-local-model

# Routing switches used by the DSL metadata
LOCAL_LLM_ENABLED=false
LITELLM_PROXY_ENABLED=true
OPENROUTER_DIRECT_ENABLED=false

# Aider defaults to the same LiteLLM alias as the developer-twin router
AIDER_MODEL=openai/twin-code
AIDER_APPLY=0
