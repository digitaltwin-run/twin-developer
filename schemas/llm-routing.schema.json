{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/subactor.llm-routing/v1",
  "title": "LLM transport routing",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policy", "routes"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "subactor.llm-routing/v1" },
    "policy": { "type": "string", "minLength": 1 },
    "modelRegistry": { "type": "string" },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "priority", "enabledEnv", "transport", "tags", "purposes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "priority": { "type": "integer", "minimum": 0 },
          "enabledEnv": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "description": "Brak zmiennej znaczy WYŁĄCZONE (llm_service.core.flag_enabled)."
          },
          "transport": { "enum": ["openai-compatible", "litellm-proxy", "openrouter"] },
          "tags": { "type": "array", "items": { "type": "string" } },
          "purposes": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["intent-extraction", "guideline-generation", "code-editing", "validation"] }
          },
          "modelAliases": { "type": "object", "additionalProperties": { "type": "string" } },
          "modelEnvs": { "type": "object", "additionalProperties": { "type": "string" } },
          "modelEnv": { "type": "string" },
          "apiBaseEnv": { "type": "string" },
          "apiKeyEnv": { "type": "string" }
        }
      }
    }
  }
}
