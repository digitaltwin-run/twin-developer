{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/subactor.developer-twin.rule-catalog/v1",
  "title": "Deterministic rule catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["rules"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "kind",
          "scope",
          "description",
          "matchAny",
          "triggers",
          "must",
          "should",
          "mustNot",
          "minSupport",
          "baseConfidence"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^DT-[A-Z]+-[0-9]{3}$" },
          "title": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["obligation", "prohibition", "preference", "decision-rule"] },
          "scope": { "enum": ["global", "subactor", "project", "contextual"] },
          "description": { "type": "string", "minLength": 1 },
          "matchAny": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 2 }
          },
          "triggers": { "type": "array", "items": { "type": "string" } },
          "must": { "type": "array", "items": { "type": "string" } },
          "should": { "type": "array", "items": { "type": "string" } },
          "mustNot": { "type": "array", "items": { "type": "string" } },
          "minSupport": { "type": "integer", "minimum": 1 },
          "baseConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "forceContextual": { "type": "boolean" }
        }
      }
    }
  }
}
