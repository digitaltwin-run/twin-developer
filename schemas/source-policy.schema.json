{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/subactor.developer-twin.source-policy/v1",
  "title": "Two independent truth rankings",
  "type": "object",
  "additionalProperties": false,
  "required": ["truthDomains", "conflictResolution", "epistemicRules"],
  "$defs": {
    "ranking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "ranking"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "ranking": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceClass", "weight"],
            "properties": {
              "sourceClass": { "type": "string", "minLength": 1 },
              "weight": { "type": "integer", "minimum": 0, "maximum": 100 },
              "note": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "truthDomains": {
      "type": "object",
      "additionalProperties": false,
      "required": ["humanIntent", "projectReality"],
      "properties": {
        "humanIntent": { "$ref": "#/$defs/ranking" },
        "projectReality": { "$ref": "#/$defs/ranking" }
      }
    },
    "conflictResolution": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "when", "winner", "reason"],
        "properties": {
          "id": { "type": "string", "pattern": "^CR-[A-Z-]+$" },
          "when": { "type": "string", "minLength": 1 },
          "winner": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "epistemicRules": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
